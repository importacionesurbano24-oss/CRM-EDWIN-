# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # solo backend, NUNCA al cliente

# WhatsApp Business Cloud API — Meta Business Manager > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=      # cadena que tú inventas, se configura igual en Meta
WHATSAPP_APP_SECRET=                # panel de la app en developers.facebook.com, para verificar la firma del webhook

# Claude API — console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Resend — resend.com/api-keys
# (todavía no se usa en esta primera entrega; se conecta en una fase posterior)
RESEND_API_KEY=

# App
NEXT_PUBLIC_APP_URL=                # ej. http://localhost:3000 en desarrollo
